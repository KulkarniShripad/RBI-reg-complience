{
  "_note": "SYNTHETIC ownership / exposure networks for demonstrating and testing the network check. Every entity and figure is invented. Real deployment needs the bank's own counterparty data (and MCA / CERSAI / credit-bureau feeds for ownership), which this study does not have. Amounts are in ₹ crore.",
  "scenarios": [
    {
      "id": "cb_control_and_dependence",
      "title": "Control chains and economic dependence (RBI's worked example)",
      "category": "commercial_banks",
      "description": "Reproduces the grouping illustration in the Commercial Banks Concentration Risk directions (paragraph 30): A controls A1 and A2; B controls B1, which controls B2 and B3. B1 depends on A2 (one-way), so B1 and everything it controls join A's group (downstream contagion); B depends on B1, so B joins as well (upstream contagion). Individually every counterparty is within limits; as a group they breach 25%.",
      "profile": {},
      "capital": { "tier1_capital": 1000, "tier2_capital": 200 },
      "entities": [
        { "entity_id": "A", "name": "Apex Holdings Ltd", "entity_type": "company" },
        { "entity_id": "A1", "name": "Apex Steel Ltd", "entity_type": "company" },
        { "entity_id": "A2", "name": "Apex Motors Ltd", "entity_type": "company" },
        { "entity_id": "B", "name": "Bharat Components Ltd", "entity_type": "company" },
        { "entity_id": "B1", "name": "Bharat Auto Parts Ltd", "entity_type": "company" },
        { "entity_id": "B2", "name": "Bharat Castings Ltd", "entity_type": "company" },
        { "entity_id": "B3", "name": "Bharat Forgings Ltd", "entity_type": "company" },
        { "entity_id": "C", "name": "Coastal Infra Projects Ltd", "entity_type": "company" }
      ],
      "edges": [
        { "from_entity": "A", "to_entity": "A1", "edge_type": "OWNS", "ownership_pct": 60 },
        { "from_entity": "A", "to_entity": "A2", "edge_type": "CONTROLS", "basis": "board_appointment", "evidence": "A appoints 5 of 7 directors of A2" },
        { "from_entity": "B", "to_entity": "B1", "edge_type": "OWNS", "ownership_pct": 55 },
        { "from_entity": "B1", "to_entity": "B2", "edge_type": "OWNS", "ownership_pct": 70 },
        { "from_entity": "B1", "to_entity": "B3", "edge_type": "OWNS", "ownership_pct": 51 },
        { "from_entity": "B1", "to_entity": "A2", "edge_type": "ECONOMIC_DEPENDENCE", "criterion": 3, "evidence": "80% of B1's output is sold to A2" },
        { "from_entity": "B", "to_entity": "B1", "edge_type": "ECONOMIC_DEPENDENCE", "criterion": 1, "evidence": "B1 accounts for 60% of B's gross receipts" }
      ],
      "exposures": [
        { "entity_id": "A", "amount": 75 },
        { "entity_id": "A1", "amount": 60 },
        { "entity_id": "A2", "amount": 55 },
        { "entity_id": "B", "amount": 40 },
        { "entity_id": "B1", "amount": 30 },
        { "entity_id": "B2", "amount": 20 },
        { "entity_id": "B3", "amount": 10 },
        { "entity_id": "C", "amount": 210 }
      ],
      "expected": [
        { "rule_key": "cb_group", "members_include": ["A", "A1", "A2", "B", "B1", "B2", "B3"], "status": "BREACH", "exposure": 290 },
        { "rule_key": "cb_single", "subject": "A", "status": "PASS" },
        { "rule_key": "cb_single", "subject": "C", "status": "BREACH" },
        { "rule_key": "cb_large_exposure", "subject": "C", "status": "REPORTABLE" },
        { "rule_key": "cb_econ_assessment", "subject": "A", "status": "ASSESSMENT_REQUIRED" },
        { "rule_key": "cb_econ_assessment", "subject": "A2", "status": "PASS" }
      ]
    },
