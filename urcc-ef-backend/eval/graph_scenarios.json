        { "entity_id": "N", "amount": 120 },
        { "entity_id": "BK", "amount": 230, "exposure_kind": "interbank" },
        { "entity_id": "Q", "amount": 260, "crm_amount": 100, "crm_provider": "GB" },
        { "entity_id": "GOI", "amount": 500, "exposure_kind": "investment" }
      ],
      "expected": [
        { "rule_key": "cb_group", "members_include": ["PSU1", "PSU2"], "absent": true },
        { "rule_key": "cb_group", "members_include": ["O", "SPV"], "absent": true },
