        { "entity_id": "PSU1", "name": "National Power Corp", "entity_type": "company", "attributes": { "government_company": true } },
        { "entity_id": "PSU2", "name": "National Rail Freight Corp", "entity_type": "company", "attributes": { "government_company": true } },
        { "entity_id": "O", "name": "Orbit Finance Originator Ltd", "entity_type": "company" },
        { "entity_id": "SPV", "name": "Orbit Receivables Trust 2026 (SPV)", "entity_type": "trust" },
        { "entity_id": "M", "name": "Meridian Shipping Ltd", "entity_type": "company" },
        { "entity_id": "N", "name": "Northstar Ports Ltd", "entity_type": "company" },
        { "entity_id": "BK", "name": "Coastal Commercial Bank", "entity_type": "bank" },
        { "entity_id": "GB", "name": "Guarantor Bank Ltd", "entity_type": "bank" },
        { "entity_id": "Q", "name": "Quantum Chemicals Ltd", "entity_type": "company" }
      ],
      "edges": [
        { "from_entity": "GOI", "to_entity": "PSU1", "edge_type": "OWNS", "ownership_pct": 100 },
        { "from_entity": "GOI", "to_entity": "PSU2", "edge_type": "OWNS", "ownership_pct": 100 },
        { "from_entity": "O", "to_entity": "SPV", "edge_type": "CONTROLS", "basis": "accounting_standard", "status": "rebutted", "evidence": "SPV is bankruptcy remote; demonstrated to RBI (DOS) that there is no channel of contagion" },
        { "from_entity": "N", "to_entity": "M", "edge_type": "ECONOMIC_DEPENDENCE", "criterion": 7, "status": "flagged", "evidence": "relationship manager note: both rely on the same shipping-finance lender" }
