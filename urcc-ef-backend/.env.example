# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Gemini (writes chat answers and qualitative compliance judgements) ---
# Without a key the system still works: chat answers are built from the
# retrieved paragraphs directly (clearly labelled), and qualitative checks
# return NEEDS_REVIEW instead of a verdict.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Tried in order if the model above is unavailable (retired name, quota, overload).
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash
GEMINI_MODEL_HEAVY=gemini-2.5-pro      # only used for optional rule-refinement calls
GEMINI_TIMEOUT_MS=45000

# --- Server ---
PORT=4002                              # the dashboard calls http://localhost:4002 by default
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# --- Data (paths relative to this folder) ---
RELATIONAL_DB_PATH=./data/urcc_ef.db
VECTOR_DB_PATH=./data/urcc_ef_vectors.db
CIRCULARS_ROOT=../circulars            # source PDFs; uploads are stored here too

# --- Semantic embeddings (BAAI bge-small-en-v1.5, run locally via ONNX) ---
EMBEDDING_MODEL_ID=Xenova/bge-small-en-v1.5
EMBEDDING_MODEL_DIR=./models           # downloaded here from Hugging Face on first use (~130 MB)
EMBEDDING_ALLOW_REMOTE=true            # set false to require the files to be present already
EMBED_MISSING_ON_START=true            # embed any chunks without vectors in the background at startup

# --- Python (extraction pipeline) ---
PYTHON_BIN=python3

# --- RBI ingestion / update job ---
RBI_BASE_URL=https://rbi.org.in
RBI_MASTER_DIRECTIONS_URL=https://rbi.org.in/scripts/BS_ViewMasterDirections.aspx
RBI_UPDATE_CRON=0 3 * * *              # daily at 3am - checks for "(Updated as on ...)" changes
RBI_PDF_STORAGE_DIR=../circulars

# --- Auth (add before any real deployment - not implemented) ---
JWT_SECRET=change_me_before_deploying
