# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Gemini (replaces Ollama as the LLM backend, per project decision) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash          # current fast model for comprehension and judgment tasks
GEMINI_MODEL_HEAVY=gemini-2.5-pro      # optional: used only for low-confidence refinement queue, if you want a stronger pass

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173      # your dashboard's dev URL

# --- Database paths (relative to backend root) ---
RELATIONAL_DB_PATH=./data/urcc_ef.db
VECTOR_DB_PATH=./data/urcc_ef_vectors.db
VECTOR_MODEL_PATH=./data/vector_model.pkl

# --- Python bridge (used for vector search + the ingestion pipeline scripts) ---
PYTHON_BIN=python3

# --- RBI ingestion / update job ---
RBI_BASE_URL=https://rbi.org.in
RBI_MASTER_DIRECTIONS_URL=https://rbi.org.in/scripts/BS_ViewMasterDirections.aspx
RBI_UPDATE_CRON=0 3 * * *              # daily at 3am - checks for "(Updated as on ...)" changes
RBI_PDF_STORAGE_DIR=./scripts/circulars

# --- Auth (add before any real deployment - not implemented in v0) ---
JWT_SECRET=change_me_before_deploying
